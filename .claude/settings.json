{
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git -C * push --force*)",
      "Bash(git -C * push * --force*)",
      "Bash(git -C * push -f*)",
      "Bash(git -C * push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(git -C * reset --hard*)",
      "Bash(git checkout -- *)",
      "Bash(git checkout .)",
      "Bash(git checkout HEAD -- *)",
      "Bash(git restore *)",
      "Bash(git clean -f*)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git branch -D *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf ..*)",
      "Bash(rm -rf .)",
      "Bash(rm -rf ./)",
      "Bash(rm -rf .git*)",
      "Bash(rm -rf app*)",
      "Bash(rm -rf components*)",
      "Bash(rm -rf lib*)",
      "Bash(rm -rf supabase*)",
      "Bash(gh pr merge*)",
      "Bash(gh api *merge*)",
      "mcp__github__merge_pull_request",
      "mcp__github__enable_pr_auto_merge",
      "Bash(supabase db reset*)",
      "Bash(npx supabase db reset*)",
      "mcp__Supabase__pause_project",
      "mcp__supabase__pause_project",
      "Read(./.env*)",
      "Read(**/.env*)",
      "Bash(* .env*)",
      "Bash(*/.env*)"
    ],
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit",
      "Write",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git checkout -b *)",
      "Bash(git switch -c *)",
      "Bash(git stash list*)",
      "Bash(npm run check*)",
      "Bash(npm run typecheck*)",
      "Bash(npm run lint*)",
      "Bash(npm run build*)",
      "Bash(npm test*)",
      "Bash(npx tsc*)",
      "Bash(ls)",
      "Bash(ls *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^mcp__.*__execute_sql$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/sql-read-only.mjs"
          }
        ]
      },
      {
        "matcher": "^mcp__.*__(merge_pull_request|enable_pr_auto_merge|pause_project)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/deny-tool.mjs"
          }
        ]
      }
    ]
  }
}
